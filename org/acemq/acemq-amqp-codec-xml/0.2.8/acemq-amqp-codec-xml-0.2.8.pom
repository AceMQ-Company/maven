<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.acemq</groupId>
  <artifactId>acemq-amqp-codec-xml</artifactId>
  <version>0.2.8</version>
  <name>AceMQ AMQP XML Codec</name>
  <description>XML payloads, for the parts of an estate that speak XML and will not be
    rewritten. Also the second implementation of the codec SPI, which is what shows the seam is
    real: one implementation only proves that a class compiles against an interface written
    around it.</description>
  <url>https://github.com/AceMQ-Company/acemq-java-amqp/acemq-amqp-codec-xml</url>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>felipeg48</id>
      <name>Felipe Gutierrez</name>
      <organization>AceMQ</organization>
      <organizationUrl>https://acemq.com</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/AceMQ-Company/acemq-java-amqp.git/acemq-amqp-codec-xml</connection>
    <developerConnection>scm:git:git@github.com:AceMQ-Company/acemq-java-amqp.git/acemq-amqp-codec-xml</developerConnection>
    <url>https://github.com/AceMQ-Company/acemq-java-amqp/acemq-amqp-codec-xml</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-amqp-api</artifactId>
      <version>0.2.8</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-xml</artifactId>
      <version>2.18.2</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <version>2.18.2</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>
</project>
