    </license>
  </licenses>
  <developers>
    <developer>
      <id>felipeg48</id>
      <name>Felipe Gutierrez</name>
      <organization>AceMQ</organization>
      <organizationUrl>https://acemq.com</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/AceMQ-Company/acemq-java-amqp.git</connection>
    <developerConnection>scm:git:git@github.com:AceMQ-Company/acemq-java-amqp.git</developerConnection>
    <url>https://github.com/AceMQ-Company/acemq-java-amqp</url>
  </scm>
  <dependencies>
