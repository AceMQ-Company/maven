<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.acemq</groupId>
  <artifactId>acemq-security-api</artifactId>
  <version>0.1.0</version>
  <name>AceMQ Security API</name>
  <description>How a connection is protected and where its credentials come from. No third-party
    dependencies: this is the module every security implementation is written against, and it has
    to be addable without dragging a vendor SDK behind it.</description>
  <url>https://github.com/AceMQ-Company/acemq-java-amqp/acemq-security-api</url>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>felipeg48</id>
      <name>Felipe Gutierrez</name>
      <organization>AceMQ</organization>
      <organizationUrl>https://acemq.com</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/AceMQ-Company/acemq-java-amqp.git/acemq-security-api</connection>
    <developerConnection>scm:git:git@github.com:AceMQ-Company/acemq-java-amqp.git/acemq-security-api</developerConnection>
    <url>https://github.com/AceMQ-Company/acemq-java-amqp/acemq-security-api</url>
  </scm>
</project>
