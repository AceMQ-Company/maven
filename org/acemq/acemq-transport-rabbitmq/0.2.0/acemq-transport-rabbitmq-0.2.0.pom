<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.acemq</groupId>
  <artifactId>acemq-transport-rabbitmq</artifactId>
  <version>0.2.0</version>
  <name>AceMQ AMQP Transport: RabbitMQ</name>
  <description>AMQP 0-9-1 transport backed by the RabbitMQ Java client, including topology-aware recovery and blocked-connection handling.</description>
  <url>https://github.com/AceMQ-Company/acemq-java-amqp/acemq-transport-rabbitmq</url>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>felipeg48</id>
      <name>Felipe Gutierrez</name>
      <organization>AceMQ</organization>
      <organizationUrl>https://acemq.com</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/AceMQ-Company/acemq-java-amqp.git/acemq-transport-rabbitmq</connection>
    <developerConnection>scm:git:git@github.com:AceMQ-Company/acemq-java-amqp.git/acemq-transport-rabbitmq</developerConnection>
    <url>https://github.com/AceMQ-Company/acemq-java-amqp/acemq-transport-rabbitmq</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-amqp-api</artifactId>
      <version>0.2.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-transport-spi</artifactId>
      <version>0.2.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.rabbitmq</groupId>
      <artifactId>amqp-client</artifactId>
      <version>5.25.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.16</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>
</project>
